@startuml
!pragma layout smetana

title Domain Model
caption Generated from JPA entities by DataModelDiagramsIT

hide empty members
skinparam classAttributeIconSize 0

class Dialogue {
  id : UUID
  createdAt : Instant
  embedding : float[]
}
class DialoguePhrase {
  id : UUID
  createdAt : Instant
  orderIndex : int
}
class DialoguePhraseTranslation {
  id : UUID
  isoLanguageCode : String
  translationText : String
}
class DialogueSpeaker {
  id : UUID
  createdAt : Instant
}
class DialogueSpeakerTranslation {
  id : UUID
  isoLanguageCode : String
  translationText : String
}
class DialogueTitleTranslation {
  id : UUID
  isoLanguageCode : String
  translationText : String
}
class ExerciseAttempt {
  id : UUID
  answerText : String
  answerType : AnswerType
  contentSubItemId : UUID
  correct : boolean
  evaluatedAt : Instant
  quality : int
  rawQuality : int
  usedHint : boolean
}
class ExerciseSession {
  id : UUID
  aggregateScore : Integer
  completedAt : Instant
  startedAt : Instant
  userId : UUID
}
class LearningCard {
  id : UUID
  createdAt : Instant
  easeFactor : double
  exerciseType : ExerciseType
  intervalDays : int
  nextReviewAt : Instant
  repetitionCount : int
  updatedAt : Instant
  variantId : UUID
}
class LearningItem {
  id : UUID
  contentItemId : UUID
  contentItemType : ContentItemType
  enrolledAt : Instant
  excludedAt : Instant
  userId : UUID
}
class Media {
  id : UUID
  aiModelUsed : String
  contentType : String
  createdAt : Instant
  sizeInBytes : int
  storageBucket : String
  storageKey : String
  storageProvider : StorageProvider
  voiceIdentifier : String
}
class Phrase {
  id : UUID
  isoLanguageCode : String
  phrase : String
  transcription : String
}
class User {
  id : UUID
  issuer : String
  subject : String
}

Dialogue "1" -- "0..*" DialoguePhrase : dialogue
Dialogue "1" -- "0..*" DialogueSpeaker : dialogue
Dialogue "1" -- "0..*" DialogueTitleTranslation : dialogue
DialoguePhrase "1" -- "0..*" DialoguePhraseTranslation : dialoguePhrase
DialogueSpeaker "1" -- "0..*" DialoguePhrase : speaker
DialogueSpeaker "1" -- "0..*" DialogueSpeakerTranslation : dialogueSpeaker
ExerciseSession "1" -- "0..*" ExerciseAttempt : session
LearningCard "1" -- "0..*" ExerciseSession : learningCard
LearningItem "1" -- "0..*" LearningCard : learningItem
Phrase "1" -- "0..*" Dialogue : title
